packages/apps/commise/mobile/android/
packages/apps/commise/mobile/ios/

# Agent-isolation git worktrees (Claude Code `isolation: worktree`). These are real checkouts of
# this repo living inside it; committing one would nest the repo in itself and balloon the tree.
.claude/worktrees/
