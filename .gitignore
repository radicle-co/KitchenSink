# Expo prebuild output (generated native projects — regenerated by `expo prebuild`)
packages/apps/commise/mobile/android/
packages/apps/commise/mobile/ios/

# Agent-isolation git worktrees (Claude Code `isolation: worktree`). These are real checkouts of
# this repo living inside it; committing one would nest the repo in itself and balloon the tree.
.claude/worktrees/

# k6 load-test CREDENTIAL MATERIAL — generated, never committed. THIS REPO IS PUBLIC.
# `tests/load/prepareClerkTokens.ts` mints a pool of real Clerk session JWTs (measured: 6,054
# signed tokens, 4.2 MB) so a k6 run can exercise the auth hot path without hammering Clerk's
# rate limit mid-test. Every one of them is a live bearer credential until it expires, so the
# pool is regenerated per run and must never reach a commit — a leaked pool is 6,000 valid
# sessions handed to whoever reads the repo. The public verification PEM is excluded for the
# same reason it is fetched rather than vendored: it is per-instance and rotates.
#
# ⚠️ GLOB, not two literal paths. This first shipped scoped to `packages/services/identity/...` and was
# WRONG THE SAME DAY: the food-service load tier grew its own `prepareClerkTokens.ts` within hours and
# put 50 live JWTs at `packages/services/food-service/tests/load/clerk-tokens.json`, outside the rule.
# Any service can grow a k6 auth tier, so the rule matches the SHAPE rather than enumerating today's
# services. Do not narrow it back to explicit paths.
packages/services/*/tests/load/clerk-tokens.json
packages/services/*/tests/load/clerk-public-key.pem
packages/services/*/tests/load/erasure-tokens.json
packages/services/*/tests/load/erasure-public-key.pem

# k6 store fixtures — `tests/load/preparePerfFixture.ts` emits the food id + search-probe lists its k6
# scripts `open()`. Not credential material, but not source: a ~180 KB machine-written blob whose contents
# are a function of the seeded row counts and which regenerates in ~15s from the prepare step. Committing
# one would put one run's row counts in the tree where the next reader mistakes them for the agreed fixture;
# the RULES that generate it are the committed artifact (`tests/load/perfFixture.ts`).
packages/services/*/tests/load/perf-fixture.json

# k6 run summaries — `--summary-export` writes these into whichever package the run was launched from
# (`k6-{scenario}-summary.json`). They are per-run measurements, not source: CI uploads them as build
# artifacts with a 7-day retention, and committing them would put one machine's timings in the tree where
# the next reader mistakes them for the agreed budgets. The budgets live in the scripts.
packages/services/*/k6-*-summary.json

# Build INTERMEDIATE of the contract generator. `src/metadata.ts` is derived wholly from the authored
# `*.schema.ts` sources, so committing it would only add a large single-line file to review diffs.
packages/services/recipe-service/src/metadata.ts
