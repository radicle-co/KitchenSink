# After a merge or pull that changed derived docs, regenerate them. It never stages or commits: the author reviews the
# files and commits them. A merge made with --no-commit never reaches this hook, so run the same command by hand then.
changed=$(git diff --name-only ORIG_HEAD HEAD -- docs/generated/components docs/generated/design)

if [ -n "$changed" ]; then
    npm run docs:generate --workspace=@kitchensink/docgen-components
    echo "Generated docs were regenerated after the merge: review and commit them."
fi
