engine-strict=true

# The shared CDK constructs (`shared/infra`) publish to GitHub Packages, which requires the npm scope to
# match the repository owner — hence `@radicle-co` rather than this platform's usual `@kitchensink`.
# ⚠️ GitHub Packages authenticates even public reads: CI uses GITHUB_TOKEN, a local install of any `infra/`
# directory needs a PAT with `read:packages` in ~/.npmrc. The root workspace install needs neither, because
# nothing in the workspace depends on this package.
@radicle-co:registry=https://npm.pkg.github.com
