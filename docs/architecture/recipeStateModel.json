        {
            "axis": "lifecycleAudience",
            "from": "PUBLISHED,PUBLIC",
            "event": "FORCE_PRIVATE",
            "actor": "system, staff",
            "guard": "the origin answer forces private, or a staff correction. A staff correction always makes the recipe private; for a new answer that can open Public it also sets HOLD_SOURCE_CORRECTED",
            "to": "PUBLISHED,PRIVATE"
        },
        {
            "axis": "lifecycleAudience",
            "from": "PUBLISHED,PUBLIC | PUBLISHED,PRIVATE",
            "event": "UNPUBLISH",
            "actor": "cook",
            "guard": "none; versions continue",
            "to": "DRAFT,PUBLIC | DRAFT,PRIVATE"
        },
        {
            "axis": "lifecycleAudience",
            "from": "any live state",
            "event": "DELETE",
            "actor": "cook, erasure",
            "guard": "none",
            "to": "DELETED"
        },
        {
            "axis": "lifecycleAudience",
            "from": "DRAFT,PRIVATE | DRAFT,PUBLIC | PUBLISHED,PRIVATE",
            "event": "ERASE_DONATE",
            "actor": "system",
            "guard": "the cook elected it; no statement owed; not ORIGIN_PERSON; no hold; sets SOURCE_CONFIRMED",
            "to": "PUBLISHED,PUBLIC"
        },
        {
            "axis": "origin",
            "from": "ORIGIN_UNSTATED, or any origin while SOURCE_UNCONFIRMED",
            "event": "ANSWER_*",
            "actor": "cook",
            "guard": "sourceLockOf = open (open holds for an unconfirmed answer that is not from a person, stored or attested); web, book and paid need a link or citation, which appends evidence and forces private",
            "to": "the answer's origin"
        },
        {
            "axis": "origin",
            "from": "ORIGIN_UNSTATED",
            "event": "PASTE_DETECTED",
            "actor": "system",
            "guard": "sets content_pasted_at only",
            "to": "unchanged"
        },
        {
            "axis": "origin",
            "from": "ORIGIN_UNSTATED",
            "event": "CURATOR_DECLARE",
            "actor": "curator",
            "guard": "grant recipes:import:public",
            "to": "ORIGIN_PUBLIC_DOMAIN"
        },
        {
            "axis": "origin",
            "from": "ORIGIN_OWN with SOURCE_CONFIRMED",
            "event": "DOWNGRADE",
            "actor": "cook",
            "guard": "a citation; a slot for a recipe that is not already private; the result is private",
            "to": "ORIGIN_BOOK | ORIGIN_PAID_SITE"
        },
        {
            "axis": "origin",
            "from": "any origin with SOURCE_CONFIRMED",
            "event": "STAFF_CORRECT",
            "actor": "staff",
            "guard": "route and grant recipes:source:correct; records who, when, old, new, reason; appends EVIDENCE_STAFF_CORRECTION; sets HOLD_SOURCE_CORRECTED if the new answer can open Public",
            "to": "staff's origin; the recipe is private; a correction that sets the hold also holds the owner's clones"
        },
        {
            "axis": "sourceConfirmation",
            "from": "SOURCE_UNCONFIRMED",
            "event": "CONFIRM",
            "actor": "cook, system, staff",
            "guard": "the source sheet answer, first publish, Save of a published recipe, erasure donation, or staff correction",
            "to": "SOURCE_CONFIRMED"
        }
    ],
