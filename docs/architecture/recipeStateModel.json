        {
            "axis": "lifecycleAudience",
            "from": "PUBLISHED,PUBLIC",
            "event": "MAKE_PRIVATE",
            "actor": "cook",
            "guard": "a slot (over the limit only for FORCE_PRIVATE)",
            "to": "PUBLISHED,PRIVATE"
