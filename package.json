{
    "name": "kitchensink",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/radicle-co/KitchenSink.git"
    },
    "homepage": "https://github.com/radicle-co/KitchenSink#readme",
    "bugs": {
        "url": "https://github.com/radicle-co/KitchenSink/issues"
    },
    "packageManager": "npm@11.11.0",
    "engines": {
        "node": "24.x"
    },
    "workspaces": [
        "packages/tools/*",
        "packages/schemas/*",
        "packages/services/*",
        "packages/shared/*",
        "packages/utils/*",
        "packages/infra/*",
        "packages/apps/commise/web",
        "packages/apps/commise/mobile",
        "packages/apps/commise/ui",
        "packages/apps/commise/i18n",
        "packages/apps/commise/features/*",
        "packages/clients/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "test": "turbo run test",
        "test:e2e": "turbo run test:e2e",
        "lint": "turbo run lint format:check",
        "boundaries": "node scripts/boundariesRatchet.mjs",
        "boundaries:update": "node scripts/boundariesRatchet.mjs --update",
        "contract:generate": "node scripts/contractGenerate.mjs",
        "contract:verify": "npm run contract:generate && node scripts/contractDriftGate.mjs",
        "infra:manifest": "node scripts/infrastructureManifest.mjs",
        "infra:manifest:check": "node scripts/infrastructureManifest.mjs --check",
        "typecheck": "turbo run typecheck",
        "dev:local": "turbo run dev",
        "localstack:up": "docker compose -f infra/localstack/docker-compose.yml up -d --wait",
        "localstack:down": "docker compose -f infra/localstack/docker-compose.yml down -v",
        "format": "turbo run format",
        "format:check": "turbo run format:check",
        "prepare": "husky || true",
        "local:up": "npm run up --workspace=@kitchensink/local-sandbox",
        "local:down": "docker compose -f .local-sandbox/docker-compose.yml -p local-sandbox down",
        "local:audit": "npm run audit --workspace=@kitchensink/local-sandbox",
        "local:seed-food": "npm run seed-food --workspace=@kitchensink/local-sandbox",
        "local:dev": "npm run local:up && turbo run dev"
    },
    "overrides": {
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@eslint/js": "^10.0.0",
        "eslint": "^10.0.3",
        "eslint-plugin-import-x": "^4.0.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^17.4.1",
        "oxlint": "1.73.0",
        "turbo": "^2.9.18",
        "typescript-eslint": "^8.56.0"
    },
    "peerDependencies": {
        "typescript": "^6.0.3"
    }
}
