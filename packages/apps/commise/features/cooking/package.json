{
    "name": "@commise/features-cooking",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run && vitest run --config vitest.native.config.ts",
        "lint": "eslint 'src/**/*.{ts,tsx}' --ignore-pattern '**/*.test.{ts,tsx}'",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@commise/features-core": "*",
        "@commise/i18n": "*",
        "@commise/ui": "*",
        "@kitchensink/cooking-core": "*",
        "@kitchensink/recipe-core": "*"
    },
    "peerDependencies": {
        "expo-keep-awake": ">=57.0.0 <58.0.0",
        "expo-speech-recognition": ">=56.0.0",
        "react": "^19.0.0",
        "react-native": ">=0.81.0"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@testing-library/react": "^16.3.0",
        "@types/react": "^19.0.0",
        "eslint": "^10.0.3",
        "expo-keep-awake": "~57.0.1",
        "expo-speech-recognition": "~56.0.1",
        "jsdom": "^24.1.0",
        "prettier": "^3.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-native": "0.86.0",
        "react-native-web": "^0.20.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
