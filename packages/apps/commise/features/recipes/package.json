{
    "name": "@commise/features-recipes",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./hooks": "./src/hooks/index.ts",
