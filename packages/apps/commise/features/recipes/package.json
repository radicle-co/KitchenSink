{
    "name": "@commise/features-recipes",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./widget/web": "./src/widget/RecipeHomeWidget.tsx",
        "./widget/mobile": "./src/widget/RecipeHomeWidget.native.tsx"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "lint": "eslint 'src/**/*.{ts,tsx}' --ignore-pattern '**/*.test.{ts,tsx}'",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@commise/features-core": "*",
        "@kitchensink/recipe-core": "*"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-native": ">=0.79.0"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@types/react": "^19.0.0",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "react": "^19.0.0",
        "react-native": "0.86.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
