{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@kitchensink/typescript/base.json",
    "compilerOptions": {
        "outDir": "dist",
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": []
    },
    // The CHECK project — everything this package owns. `test-utils/` holds the six module stubs the vitest
    // configs alias to (expo-blur, expo-image, FlashList, …); they were in no project, so a stub that had
    // drifted from the module it doubles would have compiled. `rootDir` lives in `tsconfig.build.json` because
    // a root-level `test-utils/` cannot sit in a project rooted at `src` (TS6059).
    "include": ["src/**/*.ts", "src/**/*.tsx", "test-utils/**/*.ts", "test-utils/**/*.tsx"],
    "exclude": ["node_modules", "dist"]
}
