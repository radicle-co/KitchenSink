{
    "name": "@commise/i18n",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./react": "./src/react.tsx"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "lint": "eslint 'src/**/*.{ts,tsx}' --ignore-pattern '**/*.test.{ts,tsx}'",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@formatjs/intl-localematcher": "^0.5.4",
        "negotiator": "^0.6.4"
    },
    "peerDependencies": {
        "react": "^19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@testing-library/react": "^16.3.0",
        "@types/negotiator": "^0.6.3",
        "@types/react": "^19.0.0",
        "eslint": "^10.0.3",
        "jsdom": "^24.1.0",
        "prettier": "^3.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^7.0.2",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
