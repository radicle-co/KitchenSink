{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@kitchensink/typescript/base.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": ".",
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": []
    },
    // Typecheck/editor/eslint project; `build` uses tsconfig.build.json. The integration tier under `tests/` is INCLUDED
    // so those specs get static analysis (vitest transpiles without typechecking). `rootDir` is `.` so `tests/` can be
    // part of the program at all.
    "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
