# Local development endpoint defaults — COMMITTED ON PURPOSE. Contains no secrets.
#
# `src/config/env.ts` declares these with NO fallback, because every default this replaced was an unsafe
# guess: `http://localhost:3000` on a phone is the PHONE (never the developer's machine), and
# `https://api.commise.io` was a production hostname nothing in this repo provisions.
#
# Expo loads `.env`/`.env.development` for local runs, so a simulator on the same machine as the services
# works with no setup. A DEVICE cannot reach your laptop over `localhost` — point these at your machine's
# LAN address (e.g. http://192.168.1.20:3000) in `.env.local`, which wins over this file.
#
# Ports match the canonical local table (spec NFR-009): recipe API :3000, identity API :4000.

EXPO_PUBLIC_RECIPE_API_URL=http://localhost:3000
EXPO_PUBLIC_IDENTITY_API_URL=http://localhost:4000
