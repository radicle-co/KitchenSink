{
    "expo": {
        "name": "Commise",
        "slug": "commise-mobile",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./src/assets/icon.png",
        "scheme": "commise",
        "userInterfaceStyle": "automatic",
        "splash": {
            "image": "./src/assets/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "io.commise.mobile",
            "infoPlist": {
                "CFBundleURLTypes": [
                    {
                        "CFBundleURLSchemes": ["commise", "io.commise.mobile"]
                    }
                ]
            }
        },
        "android": {
            "package": "io.commise.mobile",
            "adaptiveIcon": {
                "foregroundImage": "./src/assets/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            },
            "packageCredentials": []
        },
        "web": {
            "bundler": "metro",
            "favicon": "./src/assets/favicon.png"
        },
        "plugins": [
            [
                "@sentry/react-native/expo",
                {
                    "organization": "radicle-co",
                    "project": "commise-mobile",
                    "url": "https://sentry.io/"
                }
            ],
            "expo-image",
            [
                "@clerk/expo",
                {
                    "appleSignIn": false
                }
            ],
            [
                "expo-speech-recognition",
                {
                    "microphonePermission": "Commise uses the microphone so you can control Cooking Mode hands-free — say \"next\", \"back\" or \"start timer\" while your hands are busy.",
                    "speechRecognitionPermission": "Commise recognises a short list of cooking commands (\"next\", \"back\", \"repeat\", \"start timer\", \"pause timer\") so you can move through a recipe without touching your device."
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}
