{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    // The font-measuring fit tests (`*.fit.test.ts`), with Node's types: `@commise/ui/testing/measure-text` reads the
    // font files from disk. Their own project, so no Node global can typecheck in the app's source.
    "compilerOptions": { "types": ["node"] },
    "include": ["tests/**/*.fit.test.ts"],
    "exclude": ["node_modules", "dist"]
}
