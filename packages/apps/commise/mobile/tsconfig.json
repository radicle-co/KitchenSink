{
    "extends": "@commise/tools-typescript/base.json",
    "compilerOptions": {
        "jsx": "react-native",
        "strict": true,
        "moduleResolution": "bundler",
        "module": "ESNext",
        "target": "ESNext",
        "skipLibCheck": true,
        "lib": ["ESNext", "DOM"],
        "noEmit": true,
        "incremental": true,
        "paths": {
            "@commise/services-identity": ["../../services/identity/src/index.ts"],
            "@commise/services-identity/*": ["../../services/identity/src/*"]
        }
    },
    "include": ["src/**/*", "app/**/*", "tests/**/*", "App.tsx", "tamagui.config.ts"],
    "exclude": ["node_modules", "dist"]
}
