{
    "$schema": "https://turbo.build/schema.json",
    "extends": ["//"],
    "tasks": {
        // ⛔ THESE TWO TASKS EXIST FOR THEIR HASH, NOT TO BE RUN BY TURBO. `scripts/buildTestApp.sh content-key <platform>`
        // reads `turbo run testApp:<platform> --dry=json` and prints this task's `hash`: that string is the CONTENT KEY
        // `_mobileAppBuild.yml` names the built test app's artifact by, and an artifact of that name is reused instead of
        // rebuilt (owner, 2026-10-13: "when the inputs of a built app did not change, reuse it"). The scripts in
        // `package.json` run the same recipe directly. CI never calls them through turbo: turbo's strict env mode would
        // strip `JAVA_HOME`, the SDK paths and the Xcode selection the build needs, and `cache: false` states that
        // nothing here is ever restored from a turbo cache.
        //
        // The hash is turbo's own, so there is no hasher of ours to drift — and what it covers is asserted against turbo's
        // RESOLVED graph by `packages/tools/repoGuards/__tests__/testAppContentKey.test.ts`:
        //
        //   - `dependsOn: ["^transit"]` walks the whole dependency closure (`transit` is a no-op task, root `turbo.json`),
        //     because most workspace dependencies export `./src` with no `build` script and `^build` would skip them;
        //   - `$TURBO_DEFAULT$` is the app's own files, minus what never reaches the binary: Maestro flows, tests, and the
        //     generated native projects (`android/`, `ios/`, regenerated by `expo prebuild`), plus the build's own outputs;
        //   - `_mobileAppBuild.yml` is an input because changing HOW the app is built must not serve the old artifact;
        //   - `env` is hashed by VALUE: the three origins and the publishable key are compiled into the JS bundle
        //     (`EXPO_PUBLIC_*`), `TEST_APP_CACHE_EPOCH` is the manual flush, and iOS's `DEVELOPER_DIR` selects the Xcode.
        //
        // ⚠️ The `inputs` list is NOT a memory-aid for the build: anything the build reads that is not listed here (and is
        // not in a workspace dependency) is invisible to the key, and the stale artifact is then served.
        "testApp:android": {
            "dependsOn": ["^transit"],
            "cache": false,
            "inputs": [
                "$TURBO_DEFAULT$",
                "!.maestro/**",
                "!tests/**",
                "!**/__tests__/**",
                "!android/**",
                "!ios/**",
                "!dist/**",
                "!dist-testApp/**",
                "$TURBO_ROOT$/.github/workflows/_mobileAppBuild.yml"
            ],
            "env": [
                "EXPO_PUBLIC_RECIPE_API_URL",
                "EXPO_PUBLIC_FOOD_API_URL",
                "EXPO_PUBLIC_IDENTITY_API_URL",
                "EXPO_PUBLIC_IDP_PUBLISHABLE_KEY",
                "TEST_APP_CACHE_EPOCH"
            ],
            "outputs": []
        },
        "testApp:ios": {
            "dependsOn": ["^transit"],
            "cache": false,
            "inputs": [
                "$TURBO_DEFAULT$",
                "!.maestro/**",
                "!tests/**",
                "!**/__tests__/**",
                "!android/**",
                "!ios/**",
                "!dist/**",
                "!dist-testApp/**",
                "$TURBO_ROOT$/.github/workflows/_mobileAppBuild.yml"
            ],
            "env": [
                "EXPO_PUBLIC_RECIPE_API_URL",
                "EXPO_PUBLIC_FOOD_API_URL",
                "EXPO_PUBLIC_IDENTITY_API_URL",
                "EXPO_PUBLIC_IDP_PUBLISHABLE_KEY",
                "TEST_APP_CACHE_EPOCH",
                "DEVELOPER_DIR"
            ],
            "outputs": []
        }
    }
}
