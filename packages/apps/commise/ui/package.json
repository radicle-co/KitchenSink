{
    "name": "@commise/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node scripts/generate-theme.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint 'src/**/*.{ts,tsx}' --ignore-pattern '**/*.test.{ts,tsx}'",
        "test": "vitest run && vitest run --config vitest.native.config.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./theme.css": "./dist/theme.css",
        "./colors": "./src/tokens/colors.ts",
        "./scale": "./src/tokens/scale.ts",
        "./native": "./src/tokens/native.ts",
        "./tokens/*": {
            "types": "./dist/tokens/*.d.ts",
            "import": "./dist/tokens/*.js",
            "default": "./dist/tokens/*.js"
        },
        "./button": "./src/button/index.ts",
        "./confirm-dialog": "./src/confirmDialog/index.ts",
        "./motion": "./src/motion/index.ts",
        "./press-scale": "./src/pressScale/index.ts",
        "./surface": "./src/surface/index.ts",
        "./input": "./src/input/index.ts"
    },
    "dependencies": {
        "@radix-ui/react-alert-dialog": "^1.1.15"
    },
    "optionalDependencies": {
        "expo-blur": "~57.0.2",
        "expo-linear-gradient": "~57.0.1"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-native": ">=0.79.0"
    },
    "peerDependenciesMeta": {
        "react-native": {
            "optional": true
        }
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@testing-library/react": "^16.3.0",
        "@types/culori": "^4.0.1",
        "@types/react": "^19.0.0",
        "culori": "^4.0.2",
        "eslint": "^10.0.3",
        "jsdom": "^24.1.0",
        "prettier": "^3.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-native": "0.86.0",
        "react-native-web": "^0.20.0",
        "typescript": "^7.0.2",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
