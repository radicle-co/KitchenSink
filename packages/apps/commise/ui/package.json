{
    "name": "@commise/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node scripts/generateTheme.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run && vitest run --config vitest.native.config.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./theme.css": "./dist/theme.css",
        "./colors": "./src/tokens/colors.ts",
        "./scale": "./src/tokens/scale.ts",
        "./native": "./src/tokens/native.ts",
        "./tokens/*": {
            "types": "./dist/tokens/*.d.ts",
            "import": "./dist/tokens/*.js",
            "default": "./dist/tokens/*.js"
        },
        "./action-menu": "./src/actionMenu/index.ts",
        "./back-intercept": "./src/backIntercept/index.ts",
        "./testing/hardware-back": "./src/testing/hardwareBack.native.ts",
        "./testing/safe-area-context": "./src/testing/safeAreaContext.native.tsx",
        "./button": "./src/button/index.ts",
        "./confirm-dialog": "./src/confirmDialog/index.ts",
        "./dialog-focus": "./src/dialogFocus/index.ts",
        "./motion": "./src/motion/index.ts",
        "./press-scale": "./src/pressScale/index.ts",
        "./surface": "./src/surface/index.ts",
        "./input": "./src/input/index.ts",
        "./live-region": "./src/liveRegion/index.ts",
        "./load-more": "./src/loadMore/index.ts",
        "./pending-bar": "./src/pendingBar/index.ts",
        "./refresh-notice": "./src/refreshNotice/index.ts",
        "./screen-reader-focus": "./src/screenReaderFocus/index.ts",
        "./offline-notice": "./src/offlineNotice/index.ts",
        "./sync-notice": "./src/syncNotice/index.ts",
        "./popover": "./src/popover/index.ts",
        "./stand-in": "./src/standIn/index.ts",
        "./status-badge": "./src/statusBadge/index.ts",
        "./sheet": "./src/sheet/index.ts",
        "./variant-parts-line": "./src/variantPartsLine/index.ts"
    },
    "dependencies": {
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-dialog": "^1.1.20",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-popover": "^1.1.23"
    },
    "optionalDependencies": {
        "expo-blur": "~57.0.2",
        "expo-linear-gradient": "~57.0.1"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-native": ">=0.79.0",
        "react-native-safe-area-context": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "react-native": {
            "optional": true
        },
        "react-native-safe-area-context": {
            "optional": true
        }
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/culori": "^4.0.1",
        "@types/react": "^19.0.0",
        "culori": "^4.0.2",
        "eslint": "^10.0.3",
        "jsdom": "^30.0.1",
        "prettier": "^3.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-native": "0.86.0",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-web": "^0.21.2",
        "typescript": "^6.0.3",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
