# Local development endpoint defaults — COMMITTED ON PURPOSE. Contains no secrets.
#
# Next loads `.env.$(NODE_ENV)` only when NODE_ENV is `development`, which `next dev` sets and
# `next build` never does (it forces `production`). So these values reach a developer's machine and the
# Playwright dev server, and are INVISIBLE to any deployed build.
#
# That asymmetry is the whole design: `src/config/env.ts` declares these endpoints with NO default, so
#   - locally you get working localhost endpoints with zero setup, and
#   - a preview/production build that was not given its endpoints FAILS LOUDLY at build time
#     instead of inlining `http://localhost:3000` into the bundle it ships to real browsers.
#
# The latter is not hypothetical: it is exactly what shipped to the sandbox preview, where every
# signed-in visitor's browser called its own machine and every data surface died with
# ERR_CONNECTION_REFUSED.
#
# Ports match the canonical local table (spec NFR-009): recipe API :3000, identity API :4000.
# To develop against a deployed backend instead, override either value in `.env.local` (gitignored) —
# `.env.local` wins over `.env.development`.

NEXT_PUBLIC_RECIPE_API_URL=http://localhost:3000
NEXT_PUBLIC_IDENTITY_API_URL=http://localhost:4000

# Clerk DEVELOPMENT instance (sandbox). A pk_test key is public by design — it ships in every bundle.
# Required by src/config/env.ts, which also asserts it is stage-coherent with the endpoints above.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_bmljZS1mb3dsLTYuY2xlcmsuYWNjb3VudHMuZGV2JA
