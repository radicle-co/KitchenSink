# Commise Web — Next.js environment variables
# Copy this file to `.env.local` and fill in your values.
# Or run `node scripts/fetch-secrets.mjs` to pull Clerk keys from AWS.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# ------------------------------------------------------------------------------
# Required — Clerk authentication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# ------------------------------------------------------------------------------
# Required — API backend
# ------------------------------------------------------------------------------
# Identity/account API base origin (src/lib/identityServiceClient.ts, which src/lib/apiClient.ts reuses).
# Defaults to http://localhost:4000 in code when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Recipe management API base origin (no trailing /v1) consumed by RecipeServiceClient. Defaults to
# http://localhost:3000 in code when unset.
NEXT_PUBLIC_API_URL=http://localhost:3000
#
# These two values are ALSO pinned explicitly by the `e2e-web` job in .github/workflows/_ci.yml, so a fresh
# clone, a `scripts/fetch-secrets.mjs`-generated .env.local, and CI all resolve the API to the same origins
# instead of relying on the in-code fallbacks continuing to match. The Playwright suite does not depend on
# either origin being reachable: it intercepts with the origin-agnostic glob `page.route('**/v1/**')`, and
# the deliberately-unreachable server side is what tests/e2e/ssrPrefetch.spec.ts exercises. Point
# NEXT_PUBLIC_API_URL at a real host only for live-backend work (E2E_LIVE_BACKEND=1 / recipeLive.spec.ts).

# ------------------------------------------------------------------------------
# Optional — Webhook verification (only needed if running Clerk webhooks locally)
# ------------------------------------------------------------------------------
# CLERK_WEBHOOK_SECRET=whsec_your-webhook-secret

# ------------------------------------------------------------------------------
# Optional — Clerk routing (defaults shown)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/profile
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/profile

# ------------------------------------------------------------------------------
# Optional — Sandbox PR path routing (ADR-0001)
# ------------------------------------------------------------------------------
# Per-PR previews are served at https://sandbox.commise.app/pr-{N}/. The basePath is baked at build:
#   - On Vercel preview builds it derives automatically from VERCEL_GIT_PULL_REQUEST_ID.
#   - Off-Vercel (Docker/ECS) builds, set PREVIEW_BASE_PATH explicitly. Leave empty for production.
# PREVIEW_BASE_PATH=/pr-123
#
# Vercel project → Settings → Environment Variables (Preview scope), NOT this file:
#   NEXT_PUBLIC_API_BASE_URL = the shared sandbox identity service URL (one value, all PRs)
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY = the sandbox dev instance pk_test
# CI (KVS seeding) needs the project-wide VERCEL_AUTOMATION_BYPASS_SECRET — a CI secret, not here.

# ------------------------------------------------------------------------------
# Optional — Sentry observability
# ------------------------------------------------------------------------------
# Client-side DSN (exposed to the browser via the NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload (CI / Vercel build only)
SENTRY_ORG=radicle-co
SENTRY_PROJECT=commise-web
SENTRY_AUTH_TOKEN=
