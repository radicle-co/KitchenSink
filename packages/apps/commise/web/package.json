{
    "name": "@commise/web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "tsx scripts/buildWithEndpoints.ts",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit && tsc -p infra/tsconfig.json --noEmit",
        "test": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "router:bundle": "esbuild router/src/router.cff.js --bundle --format=esm --target=es2020 --external:cloudfront --tree-shaking=false --outfile=router/dist/router.cff.js",
        "infra:synth": "npm run router:bundle && cdk synth --app 'npx tsx infra/bin/app.ts'",
        "infra:deploy": "npm run router:bundle && cdk deploy --app 'npx tsx infra/bin/app.ts' --require-approval never",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:e2e:local": "scripts/e2e-local.sh"
    },
    "dependencies": {
        "@aws-sdk/client-cloudfront-keyvaluestore": "^3.723.0",
        "@aws-sdk/client-route-53": "^3.1096.0",
        "@aws-sdk/signature-v4a": "^3.723.0",
        "@clerk/nextjs": "^6.39.4",
        "@clerk/testing": "^2.0.35",
        "@commise/features-account": "*",
        "@commise/features-core": "*",
        "@commise/features-recipes": "*",
        "@commise/i18n": "*",
        "@commise/ui": "^0.0.0",
        "@kitchensink/recipe-service-client": "*",
        "@kitchensink/schema-identity": "*",
        "@kitchensink/schema-recipe": "*",
        "@radix-ui/react-dialog": "^1.1.20",
        "@sentry/nextjs": "^10.57.0",
        "@t3-oss/env-nextjs": "^0.13.11",
        "@tailwindcss/postcss": "^4.3.1",
        "@tanstack/react-query": "^5.62.0",
        "@testing-library/dom": "^10.4.1",
        "@vercel/analytics": "^2.0.1",
        "autoprefixer": "^10.5.0",
        "aws-cdk-lib": "*",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "constructs": "*",
        "ditox": "^3.3.0",
        "next": "^15.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.2.7",
        "react-error-boundary": "^6.1.2",
        "tailwindcss": "^4.3.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@commise/test-utils": "*",
        "@kitchensink/eslint": "*",
        "@kitchensink/infra-security": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/recipe-core": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@playwright/test": "^1.50.0",
        "@testing-library/jest-dom": "^6.0.0",
        "@testing-library/react": "^16.0.0",
        "@testing-library/user-event": "^14.0.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.0.1",
        "aws-cdk": "^2.1134.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.0.3",
        "jsdom": "^24.0.0",
        "prettier": "^3.0.0",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "uuid": "^13.0.2",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
