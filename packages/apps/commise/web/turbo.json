{
    "$schema": "https://turbo.build/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
            // basePath is baked at build time from these env vars (src/lib/basePath.ts). They MUST be in
            // the cache key or Turbo replays a stale build with the wrong basePath — the ADR-0001 subdomain
            // cutover (SANDBOX_PREVIEW_MODE=subdomain → no basePath) silently no-ops otherwise.
            "env": ["SANDBOX_PREVIEW_MODE", "PREVIEW_BASE_PATH", "VERCEL_GIT_PULL_REQUEST_ID"]
        }
    }
}
