{
    "name": "@kitchensink/recipe-service-client",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./hooks": "./src/hooks.ts"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "lint": "eslint 'src/**/*.ts' --ignore-pattern '**/*.test.ts'",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@kitchensink/recipe-core": "*",
        "@tanstack/react-query": "^5.62.0",
        "ky": "^1.7.5"
    },
    "peerDependencies": {
        "react": "^19.0.0"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@types/react": "^19.0.0",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "react": "^19.0.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
