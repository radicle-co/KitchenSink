/** One module, two boundaries: one contract-backed, one that has no published schema to parse against. */
import { thingResponseSchema } from '@kitchensink/schema-thing';
import type { ThingResponse } from '@kitchensink/schema-thing';

export async function getThing(fetchImpl: typeof fetch): Promise<ThingResponse> {
    const response = await fetchImpl('/api/v1/things/1');

    return thingResponseSchema.parse(await response.json());
}

/**
 * Probe a third-party status page.
 *
 * @unparsedBoundary Vercel's deployment API is not an API we serve (§15.3), so no contract of ours can
 *   describe this body; the two fields read here are checked inline instead.
 */
export async function probeVendor(fetchImpl: typeof fetch): Promise<string> {
    const response = await fetchImpl('https://api.vercel.com/v13/deployments');
    const body = (await response.json()) as { readonly id?: unknown };

    return typeof body.id === 'string' ? body.id : '';
}
