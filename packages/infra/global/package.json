{
    "name": "@kitchensink/infra-global",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "bundle:lambda": "node esbuild.mjs",
        "synth": "cdk synth --app 'npx tsx bin/app.ts'",
        "deploy": "npm run bundle:lambda && cdk deploy --app 'npx tsx bin/app.ts'"
    },
    "devDependencies": {
        "@aws-sdk/client-ec2": "^3.935.0",
        "@aws-sdk/client-ecs": "^3.935.0",
        "@aws-sdk/client-rds": "^3.935.0",
        "@aws-sdk/client-secrets-manager": "^3.935.0",
        "@aws-sdk/client-ssm": "^3.935.0",
        "@kitchensink/clerk-verify": "*",
        "@kitchensink/eslint": "*",
        "@kitchensink/infra-alb": "*",
        "@kitchensink/infra-messaging": "*",
        "@kitchensink/infra-security": "*",
        "@kitchensink/nest-error-envelope": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/schema-food": "*",
        "@kitchensink/schema-identity": "*",
        "@kitchensink/schema-recipe": "*",
        "@kitchensink/typescript": "*",
        "@nestjs/common": "^11.0.0",
        "@types/aws-lambda": "^8.10.147",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.11.10",
        "aws-cdk": "^2.1134.0",
        "dotenv": "*",
        "esbuild": "^0.28.1",
        "eslint": "^10.0.3",
        "jose": "^6.2.3",
        "minimatch": "^10.2.6",
        "prettier": "^3.0.0",
        "tsx": "*",
        "typescript": "^5.9.3",
        "vitest": "^4.0.0",
        "zod": "^4.4.3"
    },
    "dependencies": {
        "aws-cdk-lib": "*",
        "constructs": "*",
        "pg": "^8.13.0"
    },
    "engines": {
        "node": "24.x"
    }
}
