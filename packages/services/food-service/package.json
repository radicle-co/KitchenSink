{
    "name": "@kitchensink/food-service",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./db/schema": "./src/db/schema/index.ts"
    },
    "scripts": {
        "dev": "vite-node --watch src/main.ts",
        "build": "nest build",
        "docker:prepare": "node ../../../scripts/prepareProdManifest.mjs",
        "infra:build": "tsc -p infra/tsconfig.json",
        "bundle:lambda": "node esbuild.mjs",
        "infra:synth": "npm run bundle:lambda && cdk synth --app 'npx tsx infra/bin/app.ts'",
        "infra:deploy": "npm run bundle:lambda && cdk deploy --app 'npx tsx infra/bin/app.ts'",
        "start": "node dist/src/main.js",
        "test": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "test:load:tokens": "tsx tests/load/prepareClerkTokens.ts",
        "test:load:erasure-tokens": "tsx tests/load/prepareErasureTokens.ts",
        "test:load:fixture": "tsx tests/load/preparePerfFixture.ts",
        "test:load:drain": "tsx tests/load/drainDemotion.perf.ts",
        "test:load": "k6 run tests/load/localStoreRead.load.js && k6 run tests/load/localStoreThroughput.load.js && k6 run tests/load/search.load.js && k6 run tests/load/nutritionBatch.load.js && k6 run tests/load/authFlood.load.js",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit && tsc -p infra/tsconfig.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:generate": "drizzle-kit generate",
        "seed:usda-bulk": "tsx src/foods/seed/main.ts",
        "seed:fndds-prior": "tsx src/foods/seed/fnddsPriorMain.ts",
        "catalog:clear": "tsx src/foods/seed/clearMain.ts",
        "catalog:reseed": "tsx src/foods/seed/reseedMain.ts",
        "contract:generate": "tsx contract/generate.ts",
        "promotions:cli": "tsx src/foods/promotions/promoteCli.ts"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.716.0",
        "@aws-sdk/lib-dynamodb": "^3.716.0",
        "@aws-sdk/rds-signer": "^3.935.0",
        "@kitchensink/clerk-verify": "*",
        "@kitchensink/messaging": "*",
        "@kitchensink/nest-error-envelope": "*",
        "@kitchensink/recipe-core": "*",
        "@kitchensink/recipe-service-client": "*",
        "@kitchensink/schema-food": "*",
        "@kitchensink/usda-client": "*",
        "@nestjs/common": "^11.1.27",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.1.28",
        "aws-cdk-lib": "*",
        "constructs": "*",
        "csv-parse": "^7.0.2",
        "drizzle-orm": "^0.45.2",
        "jose": "^6.1.0",
        "nestjs-zod": "^5.5.0",
        "pg": "^8.13.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "ulidx": "^2.4.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@kitchensink/contract-gen": "*",
        "@kitchensink/eslint": "*",
        "@kitchensink/food-service-client": "*",
        "@kitchensink/infra-alb": "*",
        "@kitchensink/infra-messaging": "*",
        "@kitchensink/infra-security": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/service-test-harness": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@nestjs/cli": "^11.0.0",
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.3",
        "@types/pg": "^8.11.0",
        "aws-cdk": "^2.1134.0",
        "dotenv": "*",
        "drizzle-kit": "^0.30.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "tsx": "^4.23.12",
        "vite-node": "^6.0.0",
        "typescript": "^6.0.3",
        "undici": "^8.10.0",
        "vitest": "^4.0.0",
        "yaml": "^2.8.1"
    },
    "engines": {
        "node": "24.x"
    }
}
