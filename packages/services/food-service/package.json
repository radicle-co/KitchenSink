{
    "name": "@kitchensink/food-service",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./db/schema": "./src/db/schema/index.ts"
    },
    "scripts": {
        "dev": "nest start --watch",
        "build": "nest build",
        "docker:prepare": "node docker-prepare.js",
        "infra:build": "tsc -p infra/tsconfig.json",
        "bundle:lambda": "node esbuild.mjs",
        "infra:synth": "npm run bundle:lambda && cdk synth --app 'npx tsx infra/bin/app.ts'",
        "infra:deploy": "npm run bundle:lambda && cdk deploy --app 'npx tsx infra/bin/app.ts'",
        "start": "node dist/main.js",
        "test": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "lint": "eslint 'src/**/*.ts' --ignore-pattern '**/*.test.ts'",
        "typecheck": "tsc --noEmit && tsc -p infra/tsconfig.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:generate": "drizzle-kit generate"
    },
    "dependencies": {
        "@aws-sdk/rds-signer": "^3.935.0",
        "@kitchensink/clerk-verify": "*",
        "@kitchensink/usda-client": "*",
        "@nestjs/common": "^11.1.27",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "aws-cdk-lib": "*",
        "constructs": "*",
        "drizzle-orm": "^0.45.2",
        "pg": "^8.13.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "ulidx": "^2.4.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/food-service-client": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@nestjs/cli": "^11.0.0",
        "@types/express": "^5.0.6",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.11.0",
        "aws-cdk": "*",
        "dotenv": "*",
        "drizzle-kit": "^0.30.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "tsx": "*",
        "typescript": "^5.9.3",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
