{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@kitchensink/typescript/base.json",
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "outDir": "dist",
        "rootDir": ".",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    // Typecheck/editor/eslint project — it never emits (`build` uses tsconfig.build.json, which carries the
    // test exclusions). Tests are deliberately INCLUDED, co-located unit specs included: vitest transpiles
    // without typechecking, so excluding them here left them with no static analysis whatsoever.
    "include": ["src/**/*.ts", "src/**/*.d.ts", "tests/**/*.ts"],
    "exclude": ["node_modules", "dist", "infra"]
}
