{
    "name": "@kitchensink/identity-webhooks",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.build.json && npm run package",
        "infra:build": "tsc -p infra/tsconfig.json",
        "infra:synth": "cdk synth --app 'npx tsx infra/bin/app.ts'",
        "infra:deploy": "cdk deploy --app 'npx tsx infra/bin/app.ts'",
        "test": "vitest run",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit && tsc -p infra/tsconfig.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "package": "node esbuild.mjs",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:e2e": "vitest run --config vitest.e2e.config.ts"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/infra-security": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@types/aws-lambda": "^8.10.147",
        "@types/debug": "^4.1.12",
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.3",
        "aws-cdk": "^2.1134.0",
        "dotenv": "^17.4.2",
        "esbuild": "^0.28.1",
        "eslint": "^10.0.3",
        "msw": "^2.14.6",
        "prettier": "^3.0.0",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "vitest": "^4.0.0"
    },
    "dependencies": {
        "@aws-lambda-powertools/logger": "^2.33.1",
        "@aws-lambda-powertools/metrics": "^2.29.0",
        "@aws-sdk/client-secrets-manager": "^3.935.0",
        "@aws-sdk/client-sqs": "^3.935.0",
        "@clerk/backend": "^3.16.12",
        "@kitchensink/identity-core": "*",
        "@kitchensink/identity-db": "*",
        "@kitchensink/identity-service": "*",
        "@kitchensink/identity-utils": "*",
        "@kitchensink/recipe-core": "*",
        "@sentry/aws-serverless": "^10.57.0",
        "aws-cdk-lib": "*",
        "constructs": "*",
        "debug": "^4.3.7",
        "drizzle-orm": "^0.45.2",
        "jose": "^6.1.0",
        "pg": "^8.16.3",
        "svix": "^2.1.0"
    },
    "engines": {
        "node": "24.x"
    }
}
