{
    "name": "@kitchensink/identity-service",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./types": "./src/types/index.ts",
        "./types/*": "./src/types/*.ts",
        "./users/handle-sync-publisher": "./src/users/handleSync.publisher.ts"
    },
    "scripts": {
        "dev": "vite-node --watch src/main.ts",
        "build": "nest build",
        "infra:build": "tsc -p infra/tsconfig.json",
        "bundle:lambda": "node esbuild.mjs",
        "infra:synth": "npm run bundle:lambda && cdk synth --app 'npx tsx infra/bin/app.ts'",
        "infra:deploy": "npm run bundle:lambda && cdk deploy --app 'npx tsx infra/bin/app.ts'",
        "start": "node dist/src/main.js",
        "test": "vitest run",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:load:tokens": "tsx tests/load/prepareClerkTokens.ts",
        "test:load:db": "tsx tests/load/prepareDb.ts",
        "test:load": "k6 run tests/load/sessionHotPath.load.js && k6 run tests/load/authRejection.load.js && k6 run tests/load/adminUserSearch.load.js && k6 run tests/load/provisioningAndRename.load.js",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit && tsc -p infra/tsconfig.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docker:prepare": "node ../../../scripts/prepareProdManifest.mjs",
        "docker:build": "docker build -t kitchensink-identity .",
        "docker:push": "aws ecr get-login-password | docker login --username AWS --password-stdin ${ECR_REGISTRY} && docker push ${ECR_REGISTRY}/kitchensink-identity:${IMAGE_TAG}",
        "contract:generate": "tsx contract/generate.ts"
    },
    "dependencies": {
        "@aws-lambda-powertools/logger": "^2.33.1",
        "@aws-sdk/client-s3": "^3.723.0",
        "@aws-sdk/client-sns": "^3.723.0",
        "@aws-sdk/client-sqs": "^3.723.0",
        "@aws-sdk/s3-request-presigner": "^3.723.0",
        "@clerk/backend": "^3.16.12",
        "@kitchensink/clerk-verify": "*",
        "@kitchensink/identity-core": "*",
        "@kitchensink/identity-db": "*",
        "@kitchensink/identity-utils": "*",
        "@kitchensink/nest-error-envelope": "*",
        "@kitchensink/schema-identity": "*",
        "@nestjs/common": "^11.1.27",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.1.28",
        "@sentry/nestjs": "^10.57.0",
        "aws-cdk-lib": "*",
        "constructs": "*",
        "debug": "^4.3.7",
        "drizzle-orm": "^0.45.2",
        "nestjs-zod": "^5.5.0",
        "pg": "^8.13.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@kitchensink/contract-gen": "*",
        "@kitchensink/eslint": "*",
        "@kitchensink/infra-alb": "*",
        "@kitchensink/infra-security": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/service-test-harness": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@nestjs/cli": "^11.0.0",
        "@types/debug": "^4.1.12",
        "@types/express": "^5.0.6",
        "@types/node": "^26.4.0",
        "@types/pg": "^8.11.0",
        "@aws-sdk/client-secrets-manager": "^3.935.0",
        "aws-cdk": "^2.1134.0",
        "dotenv": "*",
        "drizzle-kit": "^0.30.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "tsx": "^4.23.12",
        "vite-node": "^6.0.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.0",
        "yaml": "^2.8.1"
    },
    "engines": {
        "node": "24.x"
    }
}
