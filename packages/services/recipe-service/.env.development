# Local development endpoint defaults — COMMITTED ON PURPOSE. Contains no secrets.
#
# `AppConfigModule` loads this file ONLY when NODE_ENV is `development` (see `src/config/config.module.ts`
# → `localEnvFilePaths`). Deployed stages run `staging`/`production`, so these values are INVISIBLE to
# every deployed task — the same asymmetry `packages/apps/commise/web/.env.development` relies on.
#
# That asymmetry is the whole design (issue #120): `src/config/config.types.ts` declares FOOD_SERVICE_URL
# with NO default, so
#   - locally you get a working localhost endpoint with zero setup, and
#   - a deploy that was not told the food origin FAILS THE BOOT instead of silently calling
#     `http://localhost:3002` — which, inside a Fargate task, is the task itself on food's port. That is
#     not hypothetical: it is what pr-73 was actually running, with every ingredient typeahead degrading
#     to recipe-local-only and nothing anywhere reporting it.
#
# Ports match the canonical local table (spec NFR-009): recipe API :3000, food API :3002.
# To develop against a deployed food service instead, override this in `.env.local` (gitignored) —
# `.env.local` wins over `.env.development`.

FOOD_SERVICE_URL=http://localhost:3002

# The verification gate's queue (plan U11 / ADR-0024), declared with NO default in the schema for exactly
# the same reason FOOD_SERVICE_URL is: U11 shipped the gate's consumer with nothing producing a message,
# and every check in the repository stayed green. A deploy that was not told the queue must fail its boot.
#
# ⚠️ The queue does NOT have to exist for local work. `RecipesService.requestVerification` logs and swallows
# a send failure, because a lost verification request degrades to the behaviour that predates the gate — so
# a developer with no LocalStack running gets one ERROR log per recipe save and a fully working service.
# `docker compose -f docker-compose.test.yml up -d` plus `awslocal sqs create-queue --queue-name
# recipe-verification` silences it.
INGREDIENT_VERIFICATION_QUEUE_URL=http://localhost:4566/000000000000/recipe-verification
RECIPE_PARSE_QUEUE_URL=http://localhost:4566/000000000000/recipe-parse-line
