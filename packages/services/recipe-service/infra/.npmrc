# ⛔ THE SCOPE MAPPING MUST LIVE HERE, NOT ONLY AT THE REPO ROOT. npm reads a project `.npmrc` from the
# package directory and does NOT walk up, so both shapes CI uses — `cd <dir> && npm install` and
# `npm install --prefix <dir>` — resolve `@radicle-co:registry` as `undefined` when only the root has it, and
# every install goes to registry.npmjs.org and 404s on a package that was never published there. Measured
# with `npm config get @radicle-co:registry` from each directory, not assumed.
@radicle-co:registry=https://npm.pkg.github.com

# ⚠️ AUTH BELONGS HERE TOO, for the same reason and one more: GitHub Packages authenticates even a PUBLIC
# read. This is written explicitly rather than left to `actions/setup-node`'s `registry-url`, which also
# rewrites the DEFAULT registry — that would send `aws-cdk-lib` and every other public dependency to GitHub
# Packages as well. npm expands the variable, so this line is inert until a token is present: CI supplies the
# built-in GITHUB_TOKEN, and a local install needs a PAT with `read:packages`.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
