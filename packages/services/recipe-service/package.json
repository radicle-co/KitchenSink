{
    "name": "@kitchensink/recipe-service",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./src/main.ts",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "bundle:lambda": "node esbuild.mjs",
        "contract:generate": "tsx contract/generate.ts",
        "dev": "NODE_ENV=development vite-node --watch src/main.ts",
        "docker:prepare": "node ../../../scripts/prepareProdManifest.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "infra:build": "tsc -p infra/tsconfig.json",
        "infra:deploy": "npm run bundle:lambda && cdk deploy --app 'npx tsx infra/bin/app.ts'",
        "infra:synth": "npm run bundle:lambda && cdk synth --app 'npx tsx infra/bin/app.ts'",
        "ingredients:unlink": "tsx src/ingredients/unlinkMain.ts",
        "lint": "eslint .",
        "seed": "tsx src/database/seed.ts",
        "start": "node dist/src/main.js",
        "test": "vitest run",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:load": "k6 run tests/load/searchLatency.load.js && k6 run tests/load/ingredientSuggestLatency.load.js && k6 run tests/load/sc009ReadWrite.load.js && k6 run tests/load/versionArchiveRead.load.js && k6 run tests/load/saveUnderArchive.load.js && k6 run tests/load/pullFromSource.load.js && k6 run tests/load/ingredientCorrection.load.js && k6 run tests/load/parseJobCreate.load.js && k6 run tests/load/analyticsIngest.load.js && k6 run tests/load/nutritionBatch.load.js && k6 run tests/load/serviceErasure.load.js",
        "test:mutation": "stryker run",
        "typecheck": "tsc --noEmit && tsc -p infra/tsconfig.json --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-cloudfront": "^3.1083.0",
        "@aws-sdk/client-s3": "^3.1083.0",
        "@aws-sdk/client-sqs": "^3.935.0",
        "@aws-sdk/client-ssm": "^3.1079.0",
        "@aws-sdk/rds-signer": "^3.1079.0",
        "@aws-sdk/s3-request-presigner": "^3.1083.0",
        "@kitchensink/clerk-verify": "*",
        "@kitchensink/food-service-client": "*",
        "@kitchensink/identity-core": "*",
        "@kitchensink/nest-error-envelope": "*",
        "@kitchensink/recipe-core": "*",
        "@kitchensink/schema-recipe": "*",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.1.28",
        "@nestjs/throttler": "^6.4.0",
        "aws-cdk-lib": "^2.0.0",
        "constructs": "^10.0.0",
        "drizzle-orm": "^0.45.2",
        "file-type": "^22.0.2",
        "jose": "^6.2.3",
        "lru-cache": "^11.5.2",
        "nestjs-zod": "^5.5.0",
        "pg": "^8.21.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0",
        "sharp": "^0.35.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@kitchensink/contract-gen": "*",
        "@kitchensink/eslint": "*",
        "@kitchensink/infra-alb": "*",
        "@kitchensink/infra-security": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/recipe-service-client": "*",
        "@kitchensink/recipe-workers": "*",
        "@kitchensink/schema-food": "*",
        "@kitchensink/service-test-harness": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/swagger": "^11.4.6",
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/vitest-runner": "^10.0.0",
        "@types/express": "^5.0.0",
        "@types/node": "^24.13.3",
        "@types/pg": "^8.15.6",
        "aws-cdk": "^2.1134.0",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "vite-node": "^6.0.0",
        "vitest": "^4.0.0",
        "yaml": "^2.8.1"
    },
    "engines": {
        "node": "24.x"
    }
}
