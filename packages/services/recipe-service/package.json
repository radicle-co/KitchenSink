{
    "name": "@kitchensink/recipe-service",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/main.js",
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/src/main.js",
        "infra:build": "tsc -p infra/tsconfig.json",
        "bundle:lambda": "node esbuild.mjs",
        "infra:synth": "npm run bundle:lambda && cdk synth --app 'npx tsx infra/bin/app.ts'",
        "infra:deploy": "npm run bundle:lambda && cdk deploy --app 'npx tsx infra/bin/app.ts'",
        "test": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "lint": "eslint 'src/**/*.ts' --ignore-pattern '**/*.test.ts'",
        "typecheck": "tsc --noEmit && tsc -p infra/tsconfig.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:mutation": "stryker run",
        "seed": "tsx src/database/seed.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1083.0",
        "@aws-sdk/client-ssm": "^3.1079.0",
        "@aws-sdk/rds-signer": "^3.1079.0",
        "@aws-sdk/s3-request-presigner": "^3.1083.0",
        "@kitchensink/clerk-verify": "*",
        "@kitchensink/food-service-client": "*",
        "@kitchensink/recipe-core": "*",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/throttler": "^6.4.0",
        "aws-cdk-lib": "^2.0.0",
        "class-transformer": "^0.5.0",
        "class-validator": "^0.14.0",
        "constructs": "^10.0.0",
        "drizzle-orm": "^0.45.2",
        "file-type": "^19.6.0",
        "pg": "^8.21.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/recipe-service-client": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@nestjs/cli": "^11.0.0",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.15.6",
        "aws-cdk": "^2.0.0",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "tsx": "^4.0.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
