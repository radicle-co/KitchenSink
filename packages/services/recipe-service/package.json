{
    "name": "@kitchensink/recipe-service",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/main.js",
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/main.js",
        "infra:build": "tsc -p infra/tsconfig.json",
        "infra:synth": "cdk synth --app 'npx tsx infra/bin/app.ts'",
        "infra:deploy": "cdk deploy --app 'npx tsx infra/bin/app.ts'",
        "test": "vitest run",
        "lint": "eslint 'src/**/*.ts'",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0",
        "class-transformer": "^0.5.0",
        "class-validator": "^0.14.0",
        "zod": "^4.4.3",
        "aws-cdk-lib": "^2.0.0",
        "constructs": "^10.0.0"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.0",
        "@nestjs/cli": "^11.0.0",
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "aws-cdk": "^2.0.0",
        "tsx": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
