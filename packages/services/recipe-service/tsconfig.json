{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@kitchensink/typescript/base.json",
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "outDir": "dist",
        "rootDir": ".",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    // Typecheck/editor/eslint project — it never emits (`build` uses tsconfig.build.json, which keeps
    // its own test exclusions). Unit tests are deliberately INCLUDED: vitest transpiles without
    // typechecking, so excluding them here left them with no static analysis at all and let ~13 type
    // errors accumulate unseen (incl. a test double that had drifted from the interface it doubles).
    "include": ["src/**/*.ts", "tests/**/*.ts", "__tests__/**/*.ts", "contract/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
