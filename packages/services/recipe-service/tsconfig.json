{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@kitchensink/typescript/base.json",
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "outDir": "dist",
        "rootDir": ".",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/**/__tests__",
        "src/**/*.test.ts"
    ]
}
