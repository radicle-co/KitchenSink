{
    "name": "@kitchensink/cooking-core",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "dependencies": {
        "@kitchensink/recipe-core": "*",
        "sentence-splitter": "5.0.3"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:mutation": "stryker run"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/vitest-runner": "^10.0.0",
        "eslint": "^10.0.3",
        "fast-check": "^4.10.2",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": "24.x"
    }
}
