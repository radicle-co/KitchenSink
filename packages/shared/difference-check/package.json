{
    "name": "@kitchensink/difference-check",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "main": "./src/differenceCheckV1.ts",
    "types": "./src/differenceCheckV1.ts",
    "exports": {
        ".": "./src/differenceCheckV1.ts"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "generate:confusables": "tsx src/confusables/generateConfusables.ts",
        "test": "vitest run",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "stemmer": "2.0.1"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "tsx": "^4.23.15",
        "eslint": "^10.0.3",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": "24.x"
    }
}
