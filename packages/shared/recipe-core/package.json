{
    "name": "@kitchensink/recipe-core",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./testing": "./src/testing/index.ts",
        "./database-name": "./src/recipeDatabaseName.ts",
        "./food-name": "./src/foodName.ts",
        "./resolution/normalized-key": "./src/resolution/normalizedKey.ts",
        "./resolution/ranking-terms": "./src/resolution/rankingTerms.ts",
        "./resolution/ranking-tiers": "./src/resolution/rankingTiers.ts",
        "./resolution/verification-gate-policy": "./src/resolution/verificationGatePolicy.ts",
        "./resolution/verification-message": "./src/resolution/verificationMessage.ts",
        "./resolution/verification-key": "./src/resolution/verificationKey.ts",
        "./resolution/confidence": "./src/resolution/confidence.ts",
        "./spend/spend-arithmetic": "./src/spend/spendArithmetic.ts",
        "./scaling": "./src/scaling.ts",
        "./external-url": "./src/externalUrl.ts"
    },
    "dependencies": {
        "zod": "^4.4.3"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
