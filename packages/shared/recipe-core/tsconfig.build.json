{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "exclude": ["node_modules", "dist", "src/**/__tests__", "src/**/*.test.ts", "tests", "*.config.ts"],
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src"
    },
    "include": ["src/**/*.ts"]
}
