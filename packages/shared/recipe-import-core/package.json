{
    "name": "@kitchensink/recipe-import-core",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "dependencies": {
        "@kitchensink/recipe-core": "*",
        "entities": "^7.0.0",
        "fraction.js": "^5.3.4",
