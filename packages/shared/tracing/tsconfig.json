{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@kitchensink/typescript/base.json",
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "rootDir": ".",
        "noEmit": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
}
