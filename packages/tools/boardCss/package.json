{
    "name": "@kitchensink/board-css",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Reads a screen board's CSS and removes the rules no element of the board uses. The dead-selector guard in repo-guards and the board builders share one reading of the board.",
    "exports": {
        "./deadClassSelectors": "./src/deadClassSelectors.ts"
    },
    "scripts": {
        "test": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prune": "tsx bin/pruneBoards.ts"
    },
    "dependencies": {
        "css-tree": "^3.2.1",
        "parse5": "^8.0.1"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@types/css-tree": "^3.2.0",
        "@types/node": "^24.13.3",
        "eslint": "^10.0.3",
        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": "24.x"
    }
}
