{
    "name": "@kitchensink/contract-gen",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "The ONE wire-contract generator: copies a service's authored *.schema.ts into packages/schemas/<service> and derives its openapi.yaml (CODING_STANDARDS \u00a715.2)",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "typescript": "^6.0.3",
        "yaml": "^2.8.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@types/node": "^26.4.0",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
