    "devDependencies": {
        "@kitchensink/e2e-fixtures": "*",
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/recipe-service-client": "*",
        "@kitchensink/service-test-harness": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@types/node": "^24.13.3",
        "csv-parse": "^7.0.3",
