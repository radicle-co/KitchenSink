{
    "name": "@kitchensink/docgen-components",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Derives docs/generated/components + docs/generated/design from the React sources and the @commise/ui tokens. Generated output is committed and guarded by regenerate-and-diff.",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "docs:generate": "tsx bin/docgen.ts",
        "test": "vitest run && vitest run --config vitest.integration.config.ts",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@commise/ui": "*",
        "react-docgen-typescript": "^2.4.0",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@types/node": "^24.13.3",
        "@types/react": "^19.0.0",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "react": "^19.0.0",
        "tsx": "^4.20.6",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
