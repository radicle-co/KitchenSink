# Docusaurus writes both of these. They are generated output and must never be tracked: the repo-wide
# guards (oneFileOneThing, sourceControlCharacters, staticAnalysisCoverage, docLinkResolution) all read
# TRACKED files, so a committed `.docusaurus/` tree would drag thousands of generated modules into them.
#
# Scoped to this package rather than the root .gitignore so this workspace is self-contained.
build/
.docusaurus/

# `docusaurus build` writes these when the site is served from a subpath.
.cache-loader/
