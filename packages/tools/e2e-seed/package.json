{
    "name": "@kitchensink/e2e-seed",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "The seeded world a DEPLOYED end-to-end run needs, created and reclaimed through the product's own APIs",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "test": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "provision": "tsx src/provision.ts",
        "reset": "tsx src/reset.ts",
        "teardown": "tsx src/teardown.ts",
        "seed-catalog": "tsx src/seedCatalog.ts"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/schema-recipe": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@types/node": "^24.13.3",
        "eslint": "^10.0.3",
        "prettier": "^3.0.0",
        "tsx": "^4.20.6",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "@clerk/backend": "^3.16.12",
        "@kitchensink/e2e-fixtures": "*",
        "@kitchensink/food-service-client": "*",
        "@kitchensink/recipe-service-client": "*"
    }
}
