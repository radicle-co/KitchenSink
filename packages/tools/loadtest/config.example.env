# U4 tunables for the food-API load test. Copy to config.env and adjust per run.
# Read by journey.js via --env (k6) and by run.mjs (U5).

# Target — the deployed per-PR (or sandbox) food API.
# Resolve, never type: node printPublicOrigin.mjs food <stage> <apex>
FOOD_BASE_URL=

# Inputs (paths relative to packages/tools/loadtest/ — the @kitchensink/loadtest package dir).
POOL_FILE=./pool.json
CORPUS_FILE=./corpus/food-queries.json

# Clerk FAPI for in-VU token refresh — MUST match what provision-users.mjs used. Each VU re-mints its
# own ~60s session token in-run (a SharedArray token would expire mid-run and confound everything).
FAPI=https://nice-fowl-6.clerk.accounts.dev
ORIGIN=https://sandbox.commise.app
# Refresh a VU token once it is older than this. Must be < 60 (TTL) minus the max iteration duration
# (POLL_TIMEOUT_S + 2*THINK_MAX_S), so a token minted at iteration start lasts the whole iteration.
REFRESH_AFTER_S=20

# Distinct-user pool. journey.js setup() FAILS FAST unless POOL_SIZE >= MAX_VUS (VU i -> user i).
POOL_SIZE=100

# Per-VU journey pacing.
THINK_MIN_S=0.5
THINK_MAX_S=2
POLL_INTERVAL_S=2
POLL_TIMEOUT_S=20

# Staged arrival-rate profile (requests/second). baseline -> hold-at-target -> over-ramp.
# "Max we support" is what HOLD must stay healthy at; RAMP pushes past it to find saturation.
BASELINE_RATE=1
BASELINE_DURATION=30s
HOLD_RATE=2
HOLD_DURATION=1m
RAMP_RATE=3
RAMP_DURATION=1m
# maxVUs MUST cover peakRate x max-iteration-duration or k6 silently drops iterations (under-loads).
# max iter ~= POLL_TIMEOUT_S + 2*THINK_MAX_S; here ~24s, so RAMP_RATE=3 -> ~72 -> 100 with headroom.
PRE_ALLOCATED_VUS=30
MAX_VUS=100

# SC-hold pass thresholds (k6 fails the run if breached). Set final numbers from the first hold run.
THRESH_SEARCH_P95_MS=800          # p95 latency of SUCCESSFUL (200) searches
THRESH_ADD_P95_MS=1500            # p95 latency of SUCCESSFUL (202) adds
THRESH_UNEXPECTED_5XX_RATE=0.01   # fraction of food requests that 5xx (excludes shed-503s)
THRESH_AUTH_FAIL_RATE=0.005       # fraction that 401 — ~0 if refresh works; non-zero => run is suspect
THRESH_DROPPED=50                 # dropped_iterations cap — surfaces silent VU starvation
