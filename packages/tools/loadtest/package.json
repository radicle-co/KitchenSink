{
    "name": "@kitchensink/loadtest",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "k6 load-test harness: leases the fixed Clerk test pool, runs the food journey and the deployed-origin probes, and reports",
    "scripts": {
        "collect": "node observe/collectMetrics.mjs",
        "journey": "k6 run journey.js",
        "k6:install": "node installK6.mjs",
        "lint": "eslint .",
        "loadtest": "node run.mjs",
        "loadtest:reuse": "REUSE_POOL=1 node run.mjs",
        "provision:pool": "npx tsx provisionPool.ts",
        "ratelimit": "node ratelimit.mjs",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@kitchensink/e2e-fixtures": "*"
    },
    "devDependencies": {
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@types/k6": "^2.0.0",
        "tsx": "^4.20.6",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    },
    "exports": {
        ".": "./src/index.ts",
        "./pool": "./src/pool.ts",
        "./load-tier": "./src/loadTier.ts"
    }
}
