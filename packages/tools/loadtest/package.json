{
    "name": "@kitchensink/loadtest",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "k6 load-test harness for the food API (provision → k6 journey → observe → report → teardown)",
    "scripts": {
        "k6:install": "node install-k6.mjs",
        "provision": "node auth/provision-users.mjs",
        "provision:pool": "node provision-pool.mjs",
        "grant-admin": "node auth/grant-admin.mjs",
        "collect": "node observe/collect-metrics.mjs",
        "journey": "k6 run journey.js",
        "loadtest": "node run.mjs",
        "loadtest:reuse": "REUSE_POOL=1 node run.mjs",
        "ratelimit": "node ratelimit.mjs",
        "sweep": "node sweep.mjs"
    },
    "devDependencies": {
        "@types/k6": "^2.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
