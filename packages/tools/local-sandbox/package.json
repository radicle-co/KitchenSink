{
    "name": "@kitchensink/local-sandbox",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./hostLock": "./src/maestroLanes/hostLock.ts"
    },
    "scripts": {
        "audit": "tsx bin/audit.ts",
        "consumer": "tsx bin/queueConsumer.ts",
        "test": "vitest run",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "lint": "eslint .",
        "maestro": "bash bin/localMaestro.sh",
        "maestro:macUsage": "tsx bin/macLaneUsage.ts",
        "maestro:lanes": "tsx bin/maestroLanes.ts",
        "typecheck": "tsc --noEmit",
        "up": "tsx bin/up.ts"
    },
    "devDependencies": {
        "@aws-sdk/cloudfront-signer": "^3.1138.0",
        "@kitchensink/eslint": "*",
        "@kitchensink/remote-search-edge": "*",
        "@kitchensink/service-test-harness": "*",
        "@kitchensink/vitest": "*",
        "@types/aws-lambda": "^8.10.0",
        "@types/node": "^24.13.3",
        "@types/pg": "^8.11.0",
        "@types/shell-quote": "1.7.5",
        "vitest": "^4.1.12",
        "yaml": "^2.8.1"
    },
    "dependencies": {
        "@aws-sdk/client-sqs": "^3.935.0",
        "@kitchensink/e2e-fixtures": "*",
        "@kitchensink/e2e-plan": "*",
        "@kitchensink/identity-db": "*",
        "@kitchensink/identity-utils": "*",
        "drizzle-orm": "^0.45.2",
        "glob": "^13.0.6",
        "pg": "^8.16.3",
        "shell-quote": "^1.12.0",
        "zod": "^4.6.7"
    }
}
