{
    "name": "@kitchensink/remote-search-edge",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "A loopback stand-in for the remote search service's CloudFront distribution, and a deterministic USDA double behind it",
    "exports": {
        "./edge": "./src/searchEdgeStandIn.ts",
        "./signature": "./src/cloudFrontSignature.ts"
    },
    "scripts": {
        "bundle": "node bundle.mjs",
        "test": "vitest run",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@aws-sdk/client-secrets-manager": "^3.1163.0",
        "@aws-sdk/cloudfront-signer": "^3.1138.0",
        "@kitchensink/e2e-seed": "*",
        "@kitchensink/eslint": "*",
        "@kitchensink/prettier": "*",
        "@kitchensink/recipe-core": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/usda-client": "*",
        "@kitchensink/vitest": "*",
        "@types/node": "^24.13.3",
        "esbuild": "^0.28.1",
        "eslint": "^10.0.3",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": "24.x"
    }
}
