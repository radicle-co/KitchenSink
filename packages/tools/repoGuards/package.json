{
    "name": "@kitchensink/repo-guards",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Repo-wide guards: tests whose subject belongs to no single package (coding standards, docs, CI workflows and scripts, turbo and test-tier wiring). Tests of infrastructure code live with that code.",
    "exports": {
        "./cdkApps": "./__tests__/cdkApps.ts",
        "./ciAwsCommands": "./__tests__/ciAwsCommands.ts",
        "./messagingConstructSites": "./__tests__/messagingConstructSites.ts",
        "./migrationRunners": "./__tests__/migrationRunners.ts",
        "./reclamationJobs": "./__tests__/reclamationJobs.ts",
        "./roleSplitSources": "./__tests__/roleSplitSources.ts",
        "./scheduledRuleOwners": "./__tests__/scheduledRuleOwners.ts",
        "./serviceSources": "./__tests__/serviceSources.ts",
        "./sourceComments": "./__tests__/sourceComments.ts",
        "./throwawayServer": "./tests/common/throwawayServer.ts",
        "./workflowExpression": "./__tests__/workflowExpression.ts",
        "./workflowScalar": "./__tests__/workflowScalar.ts",
        "./workflowStepRunner": "./__tests__/workflowStepRunner.ts"
    },
    "scripts": {
        "test": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@kitchensink/cdk-bootstrap": "*",
        "@kitchensink/clerk-verify": "*",
        "@kitchensink/db-schema-guard": "*",
        "@kitchensink/e2e-fixtures": "*",
        "@kitchensink/e2e-seed": "*",
        "@kitchensink/eslint": "*",
        "@kitchensink/loadtest": "*",
        "@kitchensink/nest-error-envelope": "*",
        "@kitchensink/schema-food": "*",
        "@kitchensink/schema-identity": "*",
        "@kitchensink/schema-recipe": "*",
        "@kitchensink/service-test-harness": "*",
        "@kitchensink/typescript": "*",
        "@kitchensink/vitest": "*",
        "@nestjs/common": "^11.1.27",
        "@types/node": "^24.13.3",
        "@types/pg": "^8.15.6",
        "@types/picomatch": "^4.0.3",
        "@types/semver": "^7.5.8",
        "dotenv": "^17.4.2",
        "eslint": "^10.0.3",
        "glob": "^13.0.6",
        "libpg-query": "^18.1.5",
        "minimatch": "^10.2.6",
        "pg": "^8.16.3",
        "picomatch": "^4.0.4",
        "prettier": "^3.0.0",
        "reflect-metadata": "^0.2.2",
        "semver": "^7.6.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.56.0",
        "vite": "^8.3.5",
        "vitest": "^4.1.12",
        "yaml": "^2.8.1",
        "zod": "^4.6.7"
    },
    "engines": {
        "node": "24.x"
    }
}
