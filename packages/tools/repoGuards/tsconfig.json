{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@kitchensink/typescript/base.json",
    "compilerOptions": {
        "target": "ES2022",
        // ES2025 for `RegExp.escape`, which these guards use. Safe here: this package only ever runs on Node 24.
        "lib": ["ES2025"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        // `allowJs` (with `checkJs` off) gives the guards that unit-test a repo-root `scripts/*.mjs` module real types
        // for it, read from its JSDoc, instead of `any`.
        "allowJs": true,
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "__tests__/**/*.ts",
        "tests/**/*.ts",
        "vitest.config.ts",
        "vitest.integration.config.ts",
        "vitest.e2e.config.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
