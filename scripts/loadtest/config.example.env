# U4 tunables for the food-API load test. Copy to config.env and adjust per run.
# All are read by journey.js via --env (k6) / by run.mjs (U5) which exports them.

# Target — the deployed per-PR (or sandbox) food API.
FOOD_BASE_URL=https://food-pr-59.commise.app

# Inputs (paths are relative to scripts/loadtest/ when running k6 from there).
TOKENS_FILE=./tokens.json
CORPUS_FILE=./corpus/food-queries.json

# Distinct-user pool size (U1 provisioner mints this many). VU i uses token i (wraps if fewer).
POOL_SIZE=20

# Per-VU journey pacing.
THINK_MIN_S=0.5
THINK_MAX_S=2
POLL_INTERVAL_S=2
POLL_TIMEOUT_S=30

# Staged arrival-rate profile (requests/second). baseline -> hold-at-target -> over-ramp.
# "Max we support" is what the HOLD phase must stay healthy at; RAMP pushes past it to find saturation.
BASELINE_RATE=1
BASELINE_DURATION=30s
HOLD_RATE=2
HOLD_DURATION=1m
RAMP_RATE=5
RAMP_DURATION=1m
PRE_ALLOCATED_VUS=20
MAX_VUS=100

# SC-hold pass thresholds (k6 fails the run if breached). Set final numbers from the first hold run.
THRESH_SEARCH_P95_MS=800
THRESH_ADD_P95_MS=1500
THRESH_UNEXPECTED_5XX_RATE=0.01
